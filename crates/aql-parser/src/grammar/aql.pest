// AQL Grammar - Agent Query Language v0.13 (AQL 0.13.0)
//
// AQL encodes agentic intent rather than database mechanics: what the agent wants,
// not how memory works. v0.13 is one small language (spec/AQL_SPEC_v0.13.md):
// 13 verbs, each on every memory type; the engine works out how.
//
//   Memory      RECALL  STORE  UPDATE  FORGET  LINK  UNLINK
//   Namespaces  BRANCH  FORK  MERGE
//   Flow        PIPELINE  SUBSCRIBE  UNSUBSCRIBE  PUBLISH
//   Session     USE

aql = { SOI ~ statement ~ ";"? ~ EOI }

// Several statements in one request, separated by ";" (a USE applies to the rest).
script = { SOI ~ statement ~ (";" ~ statement)* ~ ";"? ~ EOI }

statement = {
    use_stmt
  | pipeline_stmt
  | recall_stmt
  | store_stmt
  | update_stmt
  | forget_stmt
  | link_stmt
  | unlink_stmt
  | branch_stmt
  | fork_stmt
  | merge_stmt
  | subscribe_stmt
  | unsubscribe_stmt
  | publish_stmt
}

// USE "crm": the namespace of the statements that follow (in the script, or the
// session) that don't name their own.
use_stmt = { ^"USE" ~ string_literal }

// ============================================================================
// Memory
// ============================================================================

// RECALL FROM SEMANTIC WHERE key = "person:ada"
// RECALL FROM PROCEDURAL LIKE "pod OOMKilled restart" CONFIDENCE 0.7
// RECALL FROM WORKING WINDOW LAST 30s
recall_stmt = { ^"RECALL" ~ ^"FROM" ~ memory_type ~ in_scope_mod? ~ predicate? ~ modifier* }

predicate = { where_pred | like_pred }
where_pred = { ^"WHERE" ~ condition_list }
like_pred = { ^"LIKE" ~ (variable | string_literal) }

// STORE INTO EPISODIC (incident_id = "inc-001", pod = "payments") TTL 7d
store_stmt = { ^"STORE" ~ ^"INTO" ~ memory_type ~ payload ~ modifier* }

// UPDATE INTO SEMANTIC WHERE key = "person:ada" (age = 36)
update_stmt = { ^"UPDATE" ~ ^"INTO" ~ memory_type ~ where_pred ~ payload ~ modifier* }

// FORGET FROM WORKING WHERE temp = true;  FORGET FROM ALL NAMESPACE "crm-try"
forget_stmt = { ^"FORGET" ~ ^"FROM" ~ memory_type ~ where_pred? ~ modifier* }

// LINK FROM SEMANTIC WHERE key = "person:ada" INTO SEMANTIC WHERE key = "org:acme"
//   TYPE "works_at" WEIGHT 0.9
// (create, or set the weight of the link that exists)
link_stmt = {
    ^"LINK" ~ link_ends ~ ^"TYPE" ~ string_literal ~ (^"WEIGHT" ~ number)? ~ namespace_mod?
}

// UNLINK FROM SEMANTIC WHERE key = "a" INTO SEMANTIC WHERE key = "b" TYPE "related"
unlink_stmt = { ^"UNLINK" ~ link_ends ~ (^"TYPE" ~ string_literal)? ~ namespace_mod? }

link_ends = { ^"FROM" ~ memory_type ~ where_pred ~ ^"INTO" ~ memory_type ~ where_pred }

// ============================================================================
// Namespaces
// ============================================================================

// BRANCH FROM "crm" INTO "crm-try" [AS OF "2026-11-01T09:00:00Z"]
branch_stmt = { ^"BRANCH" ~ ns_from_into ~ as_of_mod? }
// FORK FROM "crm" INTO "crm-copy" [AS OF …]: a full, independent copy
fork_stmt = { ^"FORK" ~ ns_from_into ~ as_of_mod? }
// MERGE FROM "crm-try" INTO "crm" [PREFER SOURCE | PREFER TARGET]
merge_stmt = { ^"MERGE" ~ ns_from_into ~ prefer_clause? }

ns_from_into = { ^"FROM" ~ string_literal ~ ^"INTO" ~ string_literal }
prefer_clause = { ^"PREFER" ~ (prefer_source | prefer_target) }
prefer_source = { ^"SOURCE" }
prefer_target = { ^"TARGET" }

// ============================================================================
// Flow
// ============================================================================

// PIPELINE bid TIMEOUT 80ms RECALL … | RECALL … | STORE …
pipeline_stmt = { ^"PIPELINE" ~ pipeline_name? ~ timeout_mod? ~ pipeline_stage ~ ("|" ~ pipeline_stage)* }
pipeline_name = { !reserved ~ identifier }
reserved = @{ (^"RECALL" | ^"STORE" | ^"UPDATE" | ^"TIMEOUT") ~ !(ASCII_ALPHANUMERIC | "_" | "-") }
pipeline_stage = { recall_stmt | store_stmt | update_stmt }
timeout_mod = { ^"TIMEOUT" ~ duration_literal }

// SUBSCRIBE TOPIC "orders" WHERE status = "paid" NAMESPACE "shop"
// SUBSCRIBE RECALL FROM SEMANTIC WHERE kind = "customer" NAMESPACE "crm"
subscribe_stmt = { ^"SUBSCRIBE" ~ (topic_sub | recall_stmt) }
topic_sub = { topic_target ~ where_pred? ~ namespace_mod? }
topic_target = { ^"TOPIC" ~ string_literal }

// UNSUBSCRIBE "sub-7f3a"
unsubscribe_stmt = { ^"UNSUBSCRIBE" ~ handle ~ namespace_mod? }
handle = { string_literal | variable | identifier }

// PUBLISH TOPIC "orders" (order_id = "o-1", status = "paid") TTL 7d NAMESPACE "shop"
publish_stmt = { ^"PUBLISH" ~ topic_target ~ payload ~ modifier* }

// ============================================================================
// Conditions and payloads
// ============================================================================

condition_list = { condition_atom ~ (logical_op ~ condition_atom)* }
condition_atom = { paren_condition | simple_condition }
paren_condition = { "(" ~ condition_list ~ ")" }
simple_condition = { field_path ~ (between_op | in_op | (operator ~ value)) }
between_op = { ^"BETWEEN" ~ value ~ ^"AND" ~ value }
in_op = { ^"IN" ~ (value_list | array_literal | variable) }
value_list = { "(" ~ value ~ ("," ~ value)* ~ ")" }
logical_op = { ^"AND" | ^"OR" }
operator = {
    ">=" | "<=" | "!=" | "<>" | "=" | ">" | "<"
  | ^"CONTAINS" | ^"STARTS_WITH" | ^"ENDS_WITH"
}

payload = { "(" ~ field_assignment ~ ("," ~ field_assignment)* ~ ")" }
field_assignment = { field_path ~ "=" ~ value }

// ============================================================================
// Modifiers
// ============================================================================

modifier = {
    namespace_mod
  | in_scope_mod
  | limit_mod
  | order_mod
  | return_mod
  | ttl_mod
  | confidence_mod
  | aggregate_mod
  | group_by_mod
  | having_mod
  | window_mod
  | with_links_mod
  | follow_links_mod
  | as_of_mod
  | with_history_mod
}

namespace_mod = { ^"NAMESPACE" ~ string_literal }
in_scope_mod = { ^"IN" ~ ^"SCOPE" ~ string_literal }
limit_mod = { ^"LIMIT" ~ integer_literal }
order_mod = { ^"ORDER" ~ ^"BY" ~ field_path ~ order_direction? }
order_direction = { ^"ASC" | ^"DESC" }
return_mod = { ^"RETURN" ~ return_field ~ ("," ~ return_field)* }
return_field = { "*" | field_path }
ttl_mod = { ^"TTL" ~ duration_literal }
// At least this similar (LIKE).
confidence_mod = { ^"CONFIDENCE" ~ number }

// AGGREGATE COUNT(*) AS uses, AVG(ctr) AS avg_ctr
aggregate_mod = { ^"AGGREGATE" ~ agg_func ~ ("," ~ agg_func)* }
agg_func = { agg_func_name ~ "(" ~ (field_path | "*") ~ ")" ~ agg_alias? }
agg_alias = { ^"AS" ~ !of_kw ~ identifier }
of_kw = @{ ^"OF" ~ !(ASCII_ALPHANUMERIC | "_" | "-") }
agg_func_name = { ^"COUNT" | ^"AVG" | ^"SUM" | ^"MIN" | ^"MAX" }
group_by_mod = { ^"GROUP" ~ ^"BY" ~ field_path ~ ("," ~ field_path)* }
having_mod = { ^"HAVING" ~ condition_list }

// WINDOW LAST 10 | WINDOW LAST 30s
window_mod = { ^"WINDOW" ~ ^"LAST" ~ (duration_literal | integer_literal) }

// WITH LINKS [TYPE "t" | TYPE ("a", "b")] [WEIGHT 0.5]  (both directions; a minimum)
with_links_mod = { ^"WITH" ~ ^"LINKS" ~ link_types? ~ weight_min? }
// FOLLOW LINKS [TYPE …] [WEIGHT …] [DEPTH n]
follow_links_mod = { ^"FOLLOW" ~ ^"LINKS" ~ link_types? ~ weight_min? ~ (^"DEPTH" ~ integer_literal)? }
link_types = { ^"TYPE" ~ (("(" ~ string_literal ~ ("," ~ string_literal)* ~ ")") | string_literal) }
weight_min = { ^"WEIGHT" ~ number }

// AS OF "2026-11-01T09:00:00Z" | AS OF $t
as_of_mod = { ^"AS" ~ ^"OF" ~ time_point }
// WITH HISTORY [BETWEEN t1 AND t2]
with_history_mod = { ^"WITH" ~ ^"HISTORY" ~ (^"BETWEEN" ~ time_point ~ ^"AND" ~ time_point)? }
time_point = { string_literal | variable }

// ============================================================================
// Primitives
// ============================================================================

memory_type = { ^"WORKING" | ^"TOOLS" | ^"PROCEDURAL" | ^"SEMANTIC" | ^"EPISODIC" | ^"ALL" }

value = { null_literal | bool_literal | float_literal | integer_literal | string_literal | variable | array_literal }
number = { float_literal | integer_literal }

null_literal = { ^"null" }
bool_literal = { ^"true" | ^"false" }
integer_literal = @{ "-"? ~ ASCII_DIGIT+ }
float_literal = @{ "-"? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }
string_literal = @{ "\"" ~ string_inner ~ "\"" }
string_inner = @{ (!("\"" | "\\") ~ ANY | "\\" ~ ANY)* }
variable = @{ "{" ~ identifier ~ "}" | "$" ~ identifier }
array_literal = { "[" ~ (value ~ ("," ~ value)*)? ~ "]" }
duration_literal = @{ ASCII_DIGIT+ ~ duration_unit }
duration_unit = { "ms" | "s" | "m" | "h" | "d" }
identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_" | "-")* }
field_path = @{ identifier ~ ("." ~ identifier)* }

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ "--" ~ (!"\n" ~ ANY)* }
