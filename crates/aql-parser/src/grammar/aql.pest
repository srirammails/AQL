// AQL Grammar - Agent Query Language v0.5, plus v0.6 draft additions
//
// AQL encodes agentic intent rather than database mechanics.
// Core design: AQL expresses what the agent wants. ADB handles how memory works.
//
// v0.6 draft: SUBSCRIBE / UNSUBSCRIBE / ACK / PUBLISH / WATCH / UNWATCH and the
// IN SCOPE "<scope>" clause (see spec/AQL_SPEC_v0.6_additions.md).
// v0.7 draft: UPDATE LINK and UNLINK (see spec/AQL_SPEC_v0.7_additions.md).

// ============================================================================
// Top-level rules
// ============================================================================

aql = { SOI ~ statement ~ EOI }

statement = {
    pipeline_stmt
  | reflect_stmt
  | scan_stmt
  | recall_stmt
  | lookup_stmt
  | load_stmt
  | store_stmt
  | update_link_stmt
  | update_stmt
  | forget_stmt
  | link_stmt
  | unlink_stmt
  | subscribe_stmt
  | unsubscribe_stmt
  | ack_stmt
  | publish_stmt
  | watch_stmt
  | unwatch_stmt
}

// ============================================================================
// PIPELINE - Chained queries with time budget
// ============================================================================

// PIPELINE bid_decision TIMEOUT 80ms
//   LOAD FROM TOOLS WHERE task = "bidding"
//   | LOOKUP FROM SEMANTIC KEY url = {url}
// Anonymous pipeline also supported:
//   PIPELINE SCAN FROM WORKING | RECALL FROM EPISODIC WHERE pod = "test"
pipeline_stmt = {
    ^"PIPELINE" ~ pipeline_name? ~ timeout_mod ~
    pipeline_stage ~ ("|" ~ pipeline_stage)*
}

// Pipeline name must not be a reserved keyword
pipeline_name = { !pipeline_reserved_keyword ~ identifier }
pipeline_reserved_keyword = { ^"SCAN" | ^"RECALL" | ^"LOOKUP" | ^"LOAD" | ^"REFLECT" | ^"TIMEOUT" }

pipeline_stage = {
    scan_stmt
  | recall_stmt
  | lookup_stmt
  | load_stmt
  | reflect_stmt
}

// ============================================================================
// REFLECT - Context assembly from multiple sources
// ============================================================================

// REFLECT FROM EPISODIC WHERE incident_id = {current},
//          FROM PROCEDURAL WHERE pattern_id = {matched}
//   WITH LINKS TYPE "applied_to"
//   THEN STORE INTO PROCEDURAL
reflect_stmt = {
    ^"REFLECT" ~ reflect_source ~ ("," ~ reflect_source)* ~
    with_links_mod? ~ follow_links_mod? ~ then_clause?
}

reflect_source = {
    ^"FROM" ~ memory_type ~ predicate?
}

then_clause = {
    ^"THEN" ~ (store_stmt | update_stmt)
}

// ============================================================================
// Read Operations
// ============================================================================

// SCAN FROM WORKING WINDOW LAST 10
scan_stmt = {
    ^"SCAN" ~ ^"FROM" ~ ^"WORKING" ~ window_mod? ~ modifier*
}

// RECALL FROM EPISODIC WHERE pod = "payments" MIN_CONFIDENCE 0.7
// Predicate is optional - allows RECALL FROM EPISODIC ORDER BY field
// v0.6: optional IN SCOPE "agent:42" after the memory type
recall_stmt = {
    ^"RECALL" ~ ^"FROM" ~ memory_type ~ in_scope_mod? ~ predicate? ~ modifier*
}

// LOOKUP FROM PROCEDURAL PATTERN $log_events THRESHOLD 0.7
// v0.6: optional IN SCOPE "agent:42" after the memory type
lookup_stmt = {
    ^"LOOKUP" ~ ^"FROM" ~ memory_type ~ in_scope_mod? ~ predicate ~ modifier*
}

// LOAD FROM TOOLS WHERE task = "bidding" ORDER BY ranking DESC LIMIT 3
load_stmt = {
    ^"LOAD" ~ ^"FROM" ~ ^"TOOLS" ~ predicate ~ modifier*
}

// ============================================================================
// Write Operations
// ============================================================================

// STORE INTO EPISODIC (incident_id = "inc-001", pod = "payments") TTL 7d
// v0.8: STORE INTO SEMANTIC FACT [MULTI] (subject = "person:ada", predicate = "works_at",
//   object = "org:acme" | value = …, confidence = 0.9, source = "chat:1")
store_stmt = {
    ^"STORE" ~ ^"INTO" ~ memory_type ~ fact_mod? ~ payload ~ modifier*
}

fact_mod = { ^"FACT" ~ multi_kw? }
multi_kw = { ^"MULTI" }

// UPDATE INTO PROCEDURAL WHERE pattern_id = "oom-fix" (confidence = 0.9)
update_stmt = {
    ^"UPDATE" ~ ^"INTO" ~ memory_type ~ ^"WHERE" ~ condition_list ~ payload ~ modifier*
}

// FORGET FROM WORKING WHERE temp = "true"
forget_stmt = {
    ^"FORGET" ~ ^"FROM" ~ memory_type ~ ^"WHERE" ~ condition_list ~ modifier*
}

// ============================================================================
// LINK - Create ontology edges
// ============================================================================

// LINK FROM PROCEDURAL WHERE pattern_id = "oom-fix"
//   TO EPISODIC WHERE incident_id = "inc-001"
//   TYPE "applied_to" WEIGHT 0.95
link_stmt = {
    ^"LINK" ~ ^"FROM" ~ memory_type ~ ^"WHERE" ~ condition_list ~
    ^"TO" ~ memory_type ~ ^"WHERE" ~ condition_list ~
    ^"TYPE" ~ string_literal ~ (^"WEIGHT" ~ float_literal)?
}

// v0.7: change existing links in place — their weight, their type, or both. The
// optional TYPE selects which links between the matched records change.
// UPDATE LINK FROM PROCEDURAL WHERE pattern_id = "oom-fix"
//   TO EPISODIC WHERE incident_id = "inc-001" TYPE "applied_to" WEIGHT 0.99
// UPDATE LINK FROM SEMANTIC WHERE key = "a" TO SEMANTIC WHERE key = "b"
//   TYPE "related" (type = "depends_on", weight = 0.4)
update_link_stmt = {
    ^"UPDATE" ~ ^"LINK" ~ ^"FROM" ~ memory_type ~ ^"WHERE" ~ condition_list ~
    ^"TO" ~ memory_type ~ ^"WHERE" ~ condition_list ~
    link_type_filter? ~ (link_weight_set | payload)
}

// v0.7: remove links without touching the records at either end.
// UNLINK FROM SEMANTIC WHERE key = "a" TO SEMANTIC WHERE key = "b" TYPE "related"
unlink_stmt = {
    ^"UNLINK" ~ ^"FROM" ~ memory_type ~ ^"WHERE" ~ condition_list ~
    ^"TO" ~ memory_type ~ ^"WHERE" ~ condition_list ~
    link_type_filter?
}

link_type_filter = { ^"TYPE" ~ string_literal }
link_weight_set = { ^"WEIGHT" ~ float_literal }

// ============================================================================
// Subscriptions and continuous queries (v0.6 draft)
// ============================================================================

// SUBSCRIBE SCOPE "team:billing" KINDS fact, edge FROM NOW
// SUBSCRIBE TOPIC "orders.events" WHERE status = "paid" FROM OFFSET 1042
subscribe_stmt = {
    ^"SUBSCRIBE" ~ subscribe_target ~ kinds_clause? ~ where_pred? ~ start_clause?
}

subscribe_target = { scope_target | topic_target }
scope_target = { ^"SCOPE" ~ string_literal }
topic_target = { ^"TOPIC" ~ string_literal }

// KINDS fact, edge
kinds_clause = { ^"KINDS" ~ record_kind ~ ("," ~ record_kind)* }
record_kind = { ^"entity" | ^"fact" | ^"edge" | ^"episode" | ^"tool" | ^"event" }

// FROM NOW | FROM OFFSET 1042
start_clause = { ^"FROM" ~ (from_now | from_offset) }
from_now = { ^"NOW" }
from_offset = { ^"OFFSET" ~ integer_literal }

// UNSUBSCRIBE "sub-7f3a"
unsubscribe_stmt = { ^"UNSUBSCRIBE" ~ handle }

// ACK "sub-7f3a" OFFSET 1042
ack_stmt = { ^"ACK" ~ handle ~ ^"OFFSET" ~ integer_literal }

// PUBLISH TOPIC "orders.events" (order_id = "o-1", status = "paid") TTL 7d
publish_stmt = { ^"PUBLISH" ~ topic_target ~ payload ~ modifier* }

// WATCH RECALL FROM SEMANTIC IN SCOPE "agent:42" WHERE predicate = "owns" LIMIT 20
//       DEBOUNCE 100ms FROM NOW
watch_stmt = { ^"WATCH" ~ watch_query ~ debounce_clause? ~ start_clause? }

// Statements a continuous query may wrap. Finer limits (the WATCH subset) are
// enforced by the planner's classifier, not the grammar.
watch_query = { recall_stmt | lookup_stmt | scan_stmt | load_stmt }

debounce_clause = { ^"DEBOUNCE" ~ duration_literal }

// UNWATCH "cq-91"
unwatch_stmt = { ^"UNWATCH" ~ handle }

// A subscription or continuous-query id
handle = { string_literal | variable | identifier }

// ============================================================================
// Predicates
// ============================================================================

predicate = {
    where_pred
  | key_pred
  | like_pred
  | pattern_pred
  | all_pred
}

where_pred = { ^"WHERE" ~ condition_list }
key_pred = { ^"KEY" ~ identifier ~ "=" ~ value }
like_pred = { ^"LIKE" ~ variable }
pattern_pred = { ^"PATTERN" ~ (variable | string_literal) ~ (^"THRESHOLD" ~ float_literal)? }
all_pred = { ^"ALL" }

// ============================================================================
// Conditions
// ============================================================================

// Top-level condition list: atoms joined by AND/OR
condition_list = { condition_atom ~ (logical_op ~ condition_atom)* }

// A condition atom is either a parenthesized group or a simple condition
condition_atom = { paren_condition | simple_condition }

// Parenthesized condition group - allows (A OR B) syntax
paren_condition = { "(" ~ condition_list ~ ")" }

// Simple condition: field op value
simple_condition = { field_path ~ operator ~ value }

// Logical operators for combining conditions
logical_op = { ^"AND" | ^"OR" }

operator = {
    ">=" | "<=" | "!=" | "<>" | "=" | ">" | "<"
  | ^"CONTAINS" | ^"STARTS_WITH" | ^"ENDS_WITH" | ^"IN"
}

// ============================================================================
// Payload (for STORE/UPDATE)
// ============================================================================

payload = { "(" ~ field_assignment ~ ("," ~ field_assignment)* ~ ")" }

field_assignment = { field_path ~ "=" ~ value }

// ============================================================================
// Modifiers
// ============================================================================

modifier = {
    limit_mod
  | order_mod
  | return_mod
  | timeout_mod
  | min_confidence_mod
  | scope_mod
  | namespace_mod
  | ttl_mod
  | aggregate_mod
  | having_mod
  | with_links_mod
  | follow_links_mod
  | window_mod
  | in_scope_mod
}

// v0.6: named scope, e.g. STORE INTO SEMANTIC (...) IN SCOPE "team:billing".
// Distinct from the v0.5 SCOPE private|shared|cluster modifier.
in_scope_mod = { ^"IN" ~ ^"SCOPE" ~ string_literal }

limit_mod = { ^"LIMIT" ~ integer_literal }

order_mod = { ^"ORDER" ~ ^"BY" ~ field_path ~ order_direction? }

order_direction = { ^"ASC" | ^"DESC" }

return_mod = { ^"RETURN" ~ return_field ~ ("," ~ return_field)* }

return_field = { "*" | field_path }

timeout_mod = { ^"TIMEOUT" ~ duration_literal }

min_confidence_mod = { ^"MIN_CONFIDENCE" ~ float_literal }

scope_mod = { ^"SCOPE" ~ scope_value }

scope_value = { ^"private" | ^"shared" | ^"cluster" }

namespace_mod = { ^"NAMESPACE" ~ string_literal }

ttl_mod = { ^"TTL" ~ duration_literal }

// AGGREGATE COUNT(*) AS uses, AVG(ctr) AS avg_ctr
aggregate_mod = { ^"AGGREGATE" ~ agg_func ~ ("," ~ agg_func)* }

agg_func = {
    agg_func_name ~ "(" ~ (field_path | "*") ~ ")" ~ agg_alias?
}

agg_alias = { ^"AS" ~ identifier }

agg_func_name = { ^"COUNT" | ^"AVG" | ^"SUM" | ^"MIN" | ^"MAX" }

// HAVING uses > 10 AND avg_ctr < 0.01
having_mod = { ^"HAVING" ~ condition_list }

// WITH LINKS ALL | WITH LINKS TYPE "applied_to"
// v0.8: TYPE IN ("a", "b"), INBOUND / BOTH, MIN_WEIGHT 0.5
with_links_mod = { ^"WITH" ~ ^"LINKS" ~ link_select ~ link_direction? ~ min_weight_mod? }

// FOLLOW LINKS TYPE "triggers"
// v0.8: FOLLOW LINKS [ALL | TYPE "t" | TYPE IN (...)] [OUTBOUND | INBOUND | BOTH]
//   [MIN_WEIGHT w] [DEPTH n]; no type = every type
follow_links_mod = {
    ^"FOLLOW" ~ ^"LINKS" ~ link_select? ~ link_direction? ~ min_weight_mod? ~ (^"DEPTH" ~ integer_literal)?
}

link_select = { link_types_all | link_types_in | link_type_one }
link_types_all = { ^"ALL" }
link_types_in = { ^"TYPE" ~ ^"IN" ~ "(" ~ string_literal ~ ("," ~ string_literal)* ~ ")" }
link_type_one = { ^"TYPE" ~ string_literal }
link_direction = { ^"OUTBOUND" | ^"INBOUND" | ^"BOTH" }
min_weight_mod = { ^"MIN_WEIGHT" ~ (float_literal | integer_literal) }

// WINDOW LAST 10 | WINDOW LAST 30s | WINDOW TOP 3 BY attention_weight | WINDOW SINCE event_id = "inc-001"
window_mod = {
    ^"WINDOW" ~ (
        (^"LAST" ~ (duration_literal | integer_literal))
      | (^"TOP" ~ integer_literal ~ ^"BY" ~ field_path)
      | (^"SINCE" ~ simple_condition)
    )
}

// ============================================================================
// Memory Types
// ============================================================================

memory_type = {
    ^"WORKING" | ^"TOOLS" | ^"PROCEDURAL" | ^"SEMANTIC" | ^"EPISODIC" | ^"ALL"
}

// ============================================================================
// Values
// ============================================================================

value = {
    null_literal
  | bool_literal
  | float_literal
  | integer_literal
  | string_literal
  | variable
  | array_literal
}

null_literal = { ^"null" | ^"NULL" }
bool_literal = { ^"true" | ^"false" | ^"TRUE" | ^"FALSE" }

integer_literal = @{ "-"? ~ ASCII_DIGIT+ }

float_literal = @{ "-"? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }

string_literal = @{ "\"" ~ string_inner ~ "\"" }
string_inner = @{ (!("\"" | "\\") ~ ANY | "\\" ~ ANY)* }

variable = @{ "{" ~ identifier ~ "}" | "$" ~ identifier }

array_literal = { "[" ~ (value ~ ("," ~ value)*)? ~ "]" }

duration_literal = @{ ASCII_DIGIT+ ~ duration_unit }
duration_unit = { "ms" | "s" | "m" | "h" | "d" }

// ============================================================================
// Identifiers and Field Paths
// ============================================================================

// Simple identifier (no dots)
identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_" | "-")* }

// Dotted field path for accessing nested fields (e.g., metadata.pod)
field_path = @{ identifier ~ ("." ~ identifier)* }

// ============================================================================
// Whitespace and Comments
// ============================================================================

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ "--" ~ (!"\n" ~ ANY)* }
